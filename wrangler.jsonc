// Production hosting on Cloudflare (lindenherald.com). Build first:
//   npm run build && npx wrangler deploy
// The site is fully static; _site/_headers and _site/_redirects are applied
// automatically (cache and security headers, 301s from the old .php pages).
{
  "name": "linden-herald",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
